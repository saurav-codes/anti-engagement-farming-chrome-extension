{
  "manifest_version": 3,
  "name": "Anti-Engagement-Farm",
  "version": "1.0",
  "description": "Hide engagement-bait tweets on Twitter with one click and keep a log of what was removed.",

  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-off-16.png",
      "32": "icons/logo-off-32.png",
      "48": "icons/logo-off-48.png",
      "128": "icons/logo-off-128.png"
    }
  },
  "icons": {
    "16": "icons/logo-on-16.png",
    "32": "icons/logo-on-32.png",
    "48": "icons/logo-on-48.png",
    "128": "icons/logo-on-128.png"
  }
}